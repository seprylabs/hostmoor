{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hostmoor",
  "version": "1.2.0",
  "identifier": "com.seprylabs.hostmoor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hostmoor",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Server- und Projektübersicht für Laravel und WordPress",
    "copyright": "© 2026 Hostmoor contributors",
    "createUpdaterArtifacts": true
  },
  "mainBinaryName": "Hostmoor",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFRjQ2QUQ0QTU2Njk2MkEKUldRcWxtYWwxR3Iwbm02dU9CL0x3dDlnNzhwVWhEVVVrUG1kYVh2eVlURHdlYStjSEFNejNPbzkK",
      "endpoints": [
        "https://github.com/seprylabs/hostmoor/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
