{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Nur was die Oberfläche braucht: Events, Fenster ziehen, Datei-Dialoge fürs Backup, https-Links öffnen",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }]
    }
  ]
}
